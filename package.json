{
  "name": "goalspace",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*"
  ],
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "npm run dev -w @goalspace/api",
    "dev:web": "npm run dev -w @goalspace/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "infra:up": "docker compose --env-file apps/api/.env up -d",
    "infra:down": "docker compose --env-file apps/api/.env down",
    "db:migrate": "npm run db:migrate -w @goalspace/api",
    "db:seed": "npm run db:seed -w @goalspace/api"
  },
  "devDependencies": {
    "turbo": "2.11.10"
  }
}
